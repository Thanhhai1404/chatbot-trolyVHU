# VHU Chatbot Environment Variables
# Cấu hình cho Gemini AI Integration

# Gemini API Key - Lấy từ: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyA0al8DNKVdNoJmOoR5f2Xtcw14p85NMQ8

# Optional: Cấu hình khác
GEMINI_MODEL=gemini-pro
